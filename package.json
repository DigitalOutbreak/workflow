{
  "name": "@digitaloutbreak/workflow",
  "version": "0.18.0",
  "description": "Drop-in workflow scaffold for AI-assisted coding with guided project discovery, PR-first feature delivery, and framework-aware CI/CD. Works with Claude Code, Codex, Gemini, Antigravity, and Open Skills agents.",
  "bin": {
    "workflow": "bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "CLAUDE.md",
    "AGENTS.md",
    "GEMINI.md",
    "LICENSE",
    "docs/",
    ".claude/",
    "templates/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:smoke": "node bin/cli.js --help",
    "test:pack": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "workflow",
    "ci-cd",
    "github-actions",
    "starter",
    "scaffold",
    "agents",
    "ai-agents",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Joey Alvarado <joeynalvarado@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalOutbreak/workflow.git"
  },
  "bugs": {
    "url": "https://github.com/DigitalOutbreak/workflow/issues"
  },
  "homepage": "https://github.com/DigitalOutbreak/workflow#readme",
  "publishConfig": {
    "access": "public"
  }
}
